# Application
APP_NAME="NOT JUST DARK"
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/lorem_ipsum_store

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Shiprocket (leave the email/password empty to keep shipping manual)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=replace-with-a-long-random-value
SHIPROCKET_AUTO_ASSIGN_AWB=False
SHIPROCKET_AUTO_PICKUP=False

# Storefront origin (product links in the Meta catalog feed)
STOREFRONT_URL=http://localhost:3000

# Meta ads (all optional; leave empty to turn each piece off)
# Conversions API: Events Manager > your dataset > Settings > Generate access token
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
# Admin ad-performance report: system-user token with ads_read
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
# Catalog feed at /api/v1/meta/catalog.csv; when set, add ?token=<value> to the feed URL
META_CATALOG_FEED_TOKEN=
META_GRAPH_VERSION=v26.0

# Required before using the public first-time admin setup endpoint
ADMIN_SETUP_KEY=replace-with-a-long-random-value

# Optional infrastructure (the API degrades gracefully when Redis is absent)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Optional transactional email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hello@notjustdark.com
SMTP_USE_TLS=True

# CORS
CORS_ORIGINS=["http://localhost:3000"]
